{
  "name": "@dsh-slop/plugin",
  "version": "0.0.1",
  "description": "Chat-native Machine, Knowledge settings, and durable Queue capabilities for DSH",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./remote-types": {
      "types": "./lib/types/remote-types.d.ts",
      "default": "./lib/types/remote-types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./http-admission": {
      "types": "./lib/types/admission.d.ts",
      "default": "./lib/types/admission.js"
    },
    "./queue-entry": {
      "types": "./lib/types/queue-entry.d.ts",
      "default": "./lib/types/queue-entry.js"
    },
    "./queue-worker-preset": {
      "types": "./lib/types/queue-worker-preset.d.ts",
      "default": "./lib/types/queue-worker-preset.js"
    },
    "./webhook-entry": {
      "types": "./lib/types/webhook-entry.d.ts",
      "default": "./lib/types/webhook-entry.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/remote-types.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "lib/types/admission.js",
    "lib/types/*.js",
    "lib/skills"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && tsdown --config tsdown.config.ts && node scripts/copy-skills.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tool-bash": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.3",
    "@dsh-slop/core": "workspace:*",
    "@dsh-slop/execution": "workspace:*",
    "@dsh-slop/knowledge": "workspace:*",
    "@dsh-slop/queue": "workspace:*",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "ws": "8.21.0",
    "zod": "catalog:",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3",
    "@dsh-slop/runtime-base": "workspace:*",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@types/ws": "8.18.1",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-goal": "0.2.1-rc.3",
    "@deepseek-ai/dsh-command-goal": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.3"
  }
}
