{
  "name": "@dsh-slop/root",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "traceability": "node --import tsx scripts/verify-traceability.ts",
    "traceability:release": "node --import tsx scripts/verify-traceability.ts --release",
    "eval:check": "node evals/harness/validate-cases.mjs && node evals/harness/self-test.mjs",
    "lint": "oxlint .",
    "check:code": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "check": "pnpm traceability && pnpm eval:check && pnpm check:code",
    "start": "node packages/launcher/dist/bin.js",
    "dev": "tsx packages/launcher/src/bin.ts",
    "release:pack": "node scripts/pack-release.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "plugin:pack": "node scripts/pack-plugin.mjs",
    "plugin:smoke": "node scripts/plugin-smoke.mjs",
    "plugin:market-index": "node scripts/plugin-market.mjs",
    "launcher:smoke": "node scripts/launcher-smoke.mjs",
    "ssh:smoke:windows": "node scripts/windows-ssh-smoke.mjs",
    "build:core": "pnpm --filter @dsh-slop/launcher... build"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vitest/coverage-v8": "4.1.8",
    "jsdom": "29.1.1",
    "lightningcss": "1.33.0",
    "npm": "11.6.0",
    "oxlint": "1.76.0",
    "ssh2": "1.17.0",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "yaml": "2.9.0",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime-node": "0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-worktree": "0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.3"
  }
}
